---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import TagSidebar from '../components/TagSidebar.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  ogImage?: string;
  tags?: string[];
  category?: string;
}

const { title, description, date, ogImage, tags = [], category } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="progress-bar" id="progress-bar"></div>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      {date && <time datetime={date.toISOString()}>{date.toISOString().split('T')[0]}</time>}
      {description && <p class="post-description">{description}</p>}
    </header>
    <div class="post-body">
      <slot />
    </div>
    {(tags.length > 0 || category) && (
      <footer class="post-tags">
        {category && <a class="tag tag-category" href={`/tags/${category.replace(/\//g, '-')}/`}>{category}</a>}
        {tags.map((t) => <a class="tag" href={`/tags/${t.replace(/\//g, '-')}/`}>{t}</a>)}
      </footer>
    )}
  </article>
  <TagSidebar />
  <TOC />
</BaseLayout>

<style>
  .post-header {
    border-bottom: none;
    height: auto;
    margin-top: calc(var(--space-12) * -1 + var(--space-4));
    margin-bottom: var(--space-8);
    padding: 0;
    display: block;
  }

  .post-header h1 {
    font-size: 2em;
    margin: 0 0 var(--space-3) 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .post-header time {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
    font-style: normal;
  }

  .post-description {
    margin: var(--space-3) 0 0 0;
    font-family: var(--font-post);
    font-size: 1.05em;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  .post-tags {
    border-top: none;
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.8em;
    padding: 2px 10px;
    border-radius: 9999px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .tag:hover {
    background: var(--color-link-hover-bg);
    color: var(--color-link-hover-text);
    border-color: var(--color-link-hover-bg);
  }

  .tag-category {
    background: var(--color-link-hover-bg);
    color: var(--color-link-hover-text);
    border-color: var(--color-link-hover-bg);
  }

  .tag-category:hover {
    background: transparent;
    color: var(--color-link-hover-bg);
  }

  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    z-index: 100;
    width: 0;
    border-radius: 0 2px 2px 0;
    background: linear-gradient(90deg, #1a1a3e, #1e2a5e, #243b6e, #1f3460, #1a2548);
    box-shadow: 0 0 14px rgba(30, 42, 94, 0.4), 0 0 24px rgba(26, 26, 62, 0.2);
  }

  .progress-bar::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3a4a8e;
    box-shadow: 0 0 10px rgba(58, 74, 142, 0.8), 0 0 20px rgba(36, 59, 110, 0.5);
  }

  :global([data-theme="dark"]) .progress-bar {
    background: linear-gradient(90deg, transparent, #d0d0d0 15%, #fafafa 40%, #fff 60%, #f5f5f5 80%, #c8c8c8);
    box-shadow: 0 0 20px rgba(240,240,240,0.55), 0 0 40px rgba(200,200,200,0.25);
  }
  :global([data-theme="dark"]) .progress-bar::after {
    background: #fff;
    box-shadow: 0 0 12px #fff, 0 0 24px rgba(255,255,255,0.9), 0 0 40px rgba(220,220,220,0.5);
  }
</style>

<script>
  const bar = document.getElementById('progress-bar');
  if (bar) {
    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      bar.style.width = Math.min(progress, 100) + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
