---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  ogImage?: string;
  tags?: string[];
  category?: string;
}

const { title, description, date, ogImage, tags = [], category } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      {date && <time datetime={date.toISOString()}>{date.toISOString().split('T')[0]}</time>}
    </header>
    <div class="post-body">
      <slot />
    </div>
    {(tags.length > 0 || category) && (
      <footer class="post-tags">
        {category && <span class="tag tag-category">{category}</span>}
        {tags.map((t) => <span class="tag">{t}</span>)}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .post-header {
    border-bottom: none;
    height: auto;
    margin-top: calc(var(--space-12) * -1 + var(--space-4));
    margin-bottom: var(--space-8);
    padding: 0;
    display: block;
  }

  .post-header h1 {
    font-size: 2em;
    margin: 0 0 var(--space-3) 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .post-header time {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
    font-style: normal;
  }

  .post-tags {
    border-top: none;
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.8em;
    padding: 2px 10px;
    border-radius: 9999px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .tag-category {
    background: var(--color-link-hover-bg);
    color: var(--color-link-hover-text);
    border-color: var(--color-link-hover-bg);
  }
</style>
