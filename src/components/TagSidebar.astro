---
import { getCollection } from 'astro:content';
import { tagSlug } from '../utils/formatting';

const posts = await getCollection('posts');
const tagCount = new Map<string, number>();

for (const post of posts) {
  if (post.data.draft) continue;
  if (post.data.category) {
    tagCount.set(post.data.category, (tagCount.get(post.data.category) || 0) + 1);
  }
  for (const t of post.data.tags || []) {
    tagCount.set(t, (tagCount.get(t) || 0) + 1);
  }
}

const tags = Array.from(tagCount.entries()).sort((a, b) => b[1] - a[1]);
const visible = tags.slice(0, 5);
const hidden = tags.slice(5);
---

<aside class="tag-sidebar">
  <h2 class="tag-sidebar-title">Tags</h2>
  <input class="tag-filter" id="tag-filter" type="text" placeholder="筛选..." />
  <ul class="tag-list">
    {visible.map(([tag, count]) => (
      <li><a href={`/tags/${tagSlug(tag)}/`} data-tag={tag}>
        <span class="tag-name">{tag}</span>
        <span class="tag-count">{count}</span>
      </a></li>
    ))}
    {hidden.length > 0 && (
      <div class="tag-more" id="tag-more">
        {hidden.map(([tag, count]) => (
          <li><a href={`/tags/${tagSlug(tag)}/`} data-tag={tag}>
            <span class="tag-name">{tag}</span>
            <span class="tag-count">{count}</span>
          </a></li>
        ))}
      </div>
    )}
  </ul>
  {hidden.length > 0 && (
    <button class="tag-toggle" id="tag-toggle">展开更多 ▾</button>
  )}
</aside>

<script>
  const toggle = document.getElementById('tag-toggle');
  const more = document.getElementById('tag-more');
  const filter = document.getElementById('tag-filter') as HTMLInputElement;
  const list = document.querySelector('.tag-list') as HTMLElement;

  let expanded = false;
  if (toggle && more) {
    toggle.addEventListener('click', () => {
      expanded = !expanded;
      toggle.textContent = expanded ? '收起 ▴' : '展开更多 ▾';
      more.style.display = expanded ? '' : 'none';
    });
  }

  if (filter && list) {
    filter.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      const items = list.querySelectorAll('li');
      let anyVisible = false;
      items.forEach((li) => {
        const a = li.querySelector('a');
        const tag = (a?.getAttribute('data-tag') || '').toLowerCase();
        const match = !q || tag.includes(q);
        (li as HTMLElement).style.display = match ? '' : 'none';
        if (match) anyVisible = true;
      });
      // 搜索时展开全部
      if (q && toggle) {
        toggle.style.display = 'none';
        if (more) more.style.display = '';
      } else if (toggle) {
        toggle.style.display = '';
        if (more && !expanded) more.style.display = 'none';
      }
    });
  }
</script>

<style>
  .tag-sidebar {
    position: fixed;
    right: calc(50% + 446px);
    top: 120px;
    width: 170px;
    max-height: calc(100dvh - 160px);
    overflow-y: auto;
  }

  @media (max-width: 1100px) {
    .tag-sidebar { display: none; }
  }

  .tag-sidebar-title {
    font-size: 0.85em;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3) 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-filter {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background: none;
    outline: none;
    font: inherit;
    font-size: 0.85em;
    padding: 4px 0;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }

  .tag-filter::placeholder {
    color: var(--color-text-tertiary);
  }

  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag-list li {
    margin-bottom: 1px;
  }

  .tag-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3px 6px;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .tag-list a:hover {
    background: var(--color-link-hover-bg);
    color: var(--color-link-hover-text);
  }

  .tag-name {
    font-size: 0.88em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-count {
    font-size: 0.75em;
    color: var(--color-text-tertiary);
    margin-left: var(--space-2);
  }

  .tag-list a:hover .tag-count {
    color: var(--color-link-hover-text);
    opacity: 0.7;
  }

  .tag-more {
    display: none;
  }

  .tag-toggle {
    display: block;
    margin-top: var(--space-2);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.78em;
    color: var(--color-text-tertiary);
    padding: 0;
    transition: color var(--transition-fast);
  }

  .tag-toggle:hover {
    color: var(--color-text);
  }
</style>
