---
import { getCollection } from 'astro:content';
import { tagSlug } from '../utils/formatting';

const posts = await getCollection('posts');
const tagCount = new Map<string, number>();

for (const post of posts) {
  if (post.data.draft) continue;
  if (post.data.category) {
    tagCount.set(post.data.category, (tagCount.get(post.data.category) || 0) + 1);
  }
  for (const t of post.data.tags || []) {
    tagCount.set(t, (tagCount.get(t) || 0) + 1);
  }
}

const tags = Array.from(tagCount.entries()).sort((a, b) => b[1] - a[1]);
const visible = tags.slice(0, 5);
const hidden = tags.slice(5);
---

<aside class="tag-sidebar">
  <h2 class="tag-sidebar-title">Tags</h2>
  <div class="tag-cloud">
    {visible.map(([tag, count]) => (
      <a class="tag-pill" href={`/tags/${tagSlug(tag)}/`}>
        {tag}<span class="pill-count">{count}</span>
      </a>
    ))}
    {hidden.length > 0 && (
      <div class="tag-cloud-more" id="tag-more">
        {hidden.map(([tag, count]) => (
          <a class="tag-pill" href={`/tags/${tagSlug(tag)}/`}>
            {tag}<span class="pill-count">{count}</span>
          </a>
        ))}
      </div>
    )}
  </div>
  {hidden.length > 0 && (
    <button class="tag-toggle" id="tag-toggle">展开更多 ▾</button>
  )}
</aside>

<script>
  const toggle = document.getElementById('tag-toggle');
  const more = document.getElementById('tag-more');
  if (toggle && more) {
    toggle.addEventListener('click', () => {
      const expanded = more.classList.toggle('open');
      toggle.textContent = expanded ? '收起 ▴' : '展开更多 ▾';
    });
  }
</script>

<style>
  .tag-sidebar {
    position: fixed;
    right: calc(50% + 446px);
    top: 120px;
    width: 170px;
    max-height: calc(100dvh - 160px);
    overflow-y: auto;
  }

  @media (max-width: 1100px) {
    .tag-sidebar { display: none; }
  }

  .tag-sidebar-title {
    font-size: 0.85em;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3) 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78em;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .tag-pill:hover {
    background: var(--color-link-hover-bg);
    color: var(--color-link-hover-text);
    border-color: var(--color-link-hover-bg);
  }

  .pill-count {
    font-size: 0.8em;
    color: var(--color-text-tertiary);
  }

  .tag-pill:hover .pill-count {
    color: var(--color-link-hover-text);
    opacity: 0.7;
  }

  .tag-cloud-more {
    display: none;
  }
  .tag-cloud-more.open {
    display: contents;
  }

  .tag-toggle {
    display: block;
    margin-top: var(--space-3);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.78em;
    color: var(--color-text-tertiary);
    padding: 0;
    transition: color var(--transition-fast);
  }

  .tag-toggle:hover {
    color: var(--color-text);
  }
</style>
