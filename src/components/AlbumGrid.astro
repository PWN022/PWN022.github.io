---
import type { Album } from '../data/albums';
import AlbumCard from './AlbumCard.astro';

interface Props {
  albums: Album[];
}

const { albums } = Astro.props;
---

<div class="album-grid" id="album-grid">
  {albums.map((album) => (
    <AlbumCard album={album} />
  ))}
</div>

<!-- Load more support — if more albums added to data, no page rebuild needed -->
<script>
  // Minimal load-more setup for future expansion
  // Currently all albums render at build time. If album count exceeds
  // PAGE_SIZE, this script handles infinite scroll + load more button.
  const PAGE_SIZE = 60;
  const grid = document.getElementById('album-grid');
  if (grid) {
    const cards = grid.querySelectorAll('.album-card');
    if (cards.length > PAGE_SIZE) {
      cards.forEach((card, i) => {
        if (i >= PAGE_SIZE) (card as HTMLElement).style.display = 'none';
      });
      // Would add IntersectionObserver + load-more button here
    }
  }
</script>
