---
import { formatDate } from '../utils/formatting';

interface Props {
  slug: string;
  title: string;
  date: Date;
}

const { slug, title, date } = Astro.props;
---

<li>
  <time datetime={date.toISOString()}>{formatDate(date, 'Y-m-d')}</time>
  <a href={`/posts/${slug}/`}>
    {title}
  </a>
</li>
