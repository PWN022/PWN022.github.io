---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatting';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 按年份 + 月份分组
const byYearMonth = new Map<number, Map<number, typeof posts>>();
for (const post of posts) {
  const d = post.data.date;
  const y = d.getFullYear();
  const m = d.getMonth() + 1;
  if (!byYearMonth.has(y)) byYearMonth.set(y, new Map());
  const months = byYearMonth.get(y)!;
  if (!months.has(m)) months.set(m, []);
  months.get(m)!.push(post);
}

const yearEntries = [...byYearMonth.entries()];
---

<BaseLayout title="Articles">
  <h1>Articles</h1>
  {yearEntries.map(([year, months], idx) => (
    <details class="archive-year" open={idx === 0}>
      <summary class="year-title">{year}</summary>
      {[...months.entries()].map(([month, monthPosts]) => (
        <section class="archive-month">
          <h3 class="month-title">{month}月</h3>
          <ul class="blog-posts">
            {monthPosts.map((post) => (
              <li>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'm-d')}</time>
                <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </details>
  ))}
</BaseLayout>

<style>
  .year-title {
    font-size: 1.4em;
    margin: var(--space-8) 0 var(--space-3) 0;
    cursor: pointer;
    list-style: none;
  }

  .year-title::-webkit-details-marker {
    display: none;
  }

  details.archive-year > summary::before {
    content: '▸ ';
    font-size: 0.8em;
    color: var(--color-text-tertiary);
  }

  details.archive-year[open] > summary::before {
    content: '▾ ';
  }

  .month-title {
    font-size: 0.95em;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin: var(--space-4) 0 var(--space-2) 0;
  }

  .archive-month ul.blog-posts li time {
    flex: 0 0 55px;
    font-variant-numeric: tabular-nums;
  }
</style>
